---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { organizeTopics } from '../lib/topics.mjs';
const topics = organizeTopics(await getCollection('pages'));
---

<Base title="主题目录" description="公开学习的主题与笔记。">
  <main id="main" class="home">
    <header class="hero">
      <h1>主题目录</h1>
      <span class="topic-count">{topics.length} 个主题</span>
    </header>
    {topics.length ? (
      <div class="topic-grid">
        {topics.map((topic) => (
          <a class="topic-card" href={topic.href}>
            <h2>{topic.title}</h2>
            <p class="card-description">{topic.description}</p>
            <div class="card-footer">
              <span>{topic.pages.length} 篇记录</span>
              <span>
                查看主题 <span aria-hidden="true">↗</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-state">暂无主题。</p>
    )}
  </main>
</Base>
